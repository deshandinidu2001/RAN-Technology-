generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Float
  category    String      // laptop-accessories, laptops, desktops, monitors, etc.
  subcategory String?     // ram, ssd, gpu, cooling-pad, display, etc.
  image       String
  images      String?     // JSON array of image URLs
  stock       Int
  featured    Boolean     @default(false)
  brand       String?
  sku         String?
  specs       String?     // JSON object of specifications
  features    String?     // JSON array of features
  // RAM specific fields
  ramType     String?     // DDR4, DDR5
  ramSpeed    Int?        // 2666, 3200, 3600, 5600 (MHz)
  ramCapacity Int?        // 8, 16, 32, 64 (GB)
  // SSD specific fields  
  ssdType     String?     // NVMe, SATA
  ssdCapacity Int?        // 256, 512, 1024, 2048 (GB)
  ssdSpeed    Int?        // Read speed in MB/s
  // GPU specific fields
  gpuMemory   Int?        // 8, 12, 16 (GB)
  gpuChipset  String?     // RTX 4060, RTX 4070, etc.
  // Display specific fields
  displaySize Float?      // 15.6, 17.3 (inches)
  displayRes  String?     // FHD, QHD, 4K
  displayType String?     // IPS, OLED, TN
  // Compatibility
  compatibility String?   // JSON array of compatible laptop models
  // For repair services
  isService   Boolean     @default(false)
  serviceType String?     // upgrade, repair, maintenance, data
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  total         Float
  status        String      @default("pending")
  shippingName  String?
  shippingEmail String?
  shippingAddress String?
  shippingCity  String?
  shippingZip   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model RepairBooking {
  id               String   @id @default(uuid())
  date             String
  timeSlot         String
  deviceType       String?
  services         String?  // JSON array of selected service IDs
  products         String?  // JSON object of service -> product selections
  totalAmount      Float?
  issueDescription String
  customerName     String
  customerEmail    String
  customerPhone    String
  status           String   @default("pending")
  notes            String?
  estimatedCost    Float?
  actualCost       Float?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RepairReview {
  id          String   @id @default(uuid())
  serviceType String   // upgrade, repair, maintenance, data
  serviceName String   // e.g., "RAM Upgrade", "Screen Repair"
  userName    String
  rating      Int      // 1-5
  comment     String
  createdAt   DateTime @default(now())
}

model ShopAvailability {
  id        String   @id @default(uuid())
  date      String   @unique
  slots     String   // JSON array of available time slots
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
