{
  "name": "ran-tech-shop-backend",
  "version": "1.0.0",
  "description": "Backend API for RAN Tech Shop",
  "main": "dist/server.js",
  "scripts": {
    "predev": "node -e \"require('kill-port')(3001).then(()=>console.log('Port 3001 cleared')).catch(()=>{})\"",
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nodemon --exec ts-node src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "db:seed": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
