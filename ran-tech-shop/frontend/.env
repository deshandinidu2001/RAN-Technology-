# API base URL
# - In dev: leave unset; Vite proxies /api → http://localhost:3001 (see vite.config.ts)
# - In prod (Vercel): leave unset; api.ts falls back to /_/backend/api (see vercel.json routing)
# Only set this if you need to point the frontend at a different backend.
# VITE_API_BASE_URL=http://localhost:3001/api

# Google OAuth — get from https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=261195760646-klfi8uhv0l7cl2v9pg6qhnug94shg95a.apps.googleusercontent.com

# Facebook — get from https://developers.facebook.com → Your App → Settings → Basic
# Add http://localhost:5173 to App Domains and Valid OAuth Redirect URIs
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
